# =============================================================================
# ConnectX Frontend Production & Development Environment Configuration
# =============================================================================

# Backend REST API Base URL
# In development: http://localhost:5000
# In production: https://api.yourdomain.com (or leave empty if hosted on same domain)
REACT_APP_API_URL=http://localhost:5000

# Backend Socket.IO Gateway URL
# In development: http://localhost:5000
# In production: https://api.yourdomain.com (or leave empty if hosted on same domain)
REACT_APP_SOCKET_URL=http://localhost:5000

# LocalStorage key for storing active user session profile (non-sensitive profile data)
REACT_APP_LOCALHOST_KEY="chat-app-current-user"
