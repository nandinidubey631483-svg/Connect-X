# =============================================================================
# ConnectX Backend Production & Development Environment Configuration
# =============================================================================

# Server Port & Runtime Environment
PORT=5000
NODE_ENV=production

# -----------------------------------------------------------------------------
# Database Configuration (MongoDB)
# -----------------------------------------------------------------------------
# Local MongoDB: mongodb://127.0.0.1:27017/chat
# Production Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chat?retryWrites=true&w=majority
MONGO_URL=mongodb://127.0.0.1:27017/chat
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

# -----------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS) & Origin Validation
# -----------------------------------------------------------------------------
# Comma-separated list of whitelisted frontend origins
# Development: http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# Reverse Proxy Trust Settings (1 for standard Nginx/Cloudflare/Caddy/Heroku proxy)
TRUST_PROXY=1

# -----------------------------------------------------------------------------
# Cryptographic Security Secrets (CRITICAL: Must be >= 32 characters each)
# Generate using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_secure_random_hex_string_at_least_64_chars_long
JWT_REFRESH_SECRET=replace_with_secure_random_hex_string_at_least_64_chars_long
CSRF_SECRET=replace_with_secure_random_hex_string_at_least_64_chars_long
COOKIE_SECRET=replace_with_secure_random_hex_string_at_least_64_chars_long

# -----------------------------------------------------------------------------
# Cookie Security & Deployment Topology
# -----------------------------------------------------------------------------
# Topology options:
#   "same-site"   -> Frontend and Backend on same root domain (e.g. app.domain.com and api.domain.com)
#   "same-origin" -> Unified deployment via reverse proxy / BFF on exact same origin (e.g. domain.com/api)
#   "cross-site"  -> Fully decoupled third-party domains (e.g. vercel.app -> render.com)
COOKIE_TOPOLOGY=same-site
COOKIE_DOMAIN=.yourdomain.com
CROSS_SITE_COOKIES=false

# -----------------------------------------------------------------------------
# Live Email & OTP Delivery Configuration (Resend HTTPS API / Nodemailer SMTP)
# -----------------------------------------------------------------------------
# Primary Cloud Provider: Resend (Port 443 - Works reliably on Render free tier)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="ConnectX <onboarding@resend.dev>"

# Fallback SMTP Provider (Optional, when outbound SMTP ports 465/587 are available)
# Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password_without_spaces

# -----------------------------------------------------------------------------
# Distributed Caching & Rate Limiting (Redis - Optional)
# -----------------------------------------------------------------------------
# If omitted, ConnectX automatically falls back to robust in-memory sliding windows
# REDIS_URL=redis://default:<password>@<host>:<port>

# -----------------------------------------------------------------------------
# WebRTC Audio & Video Calling (STUN / TURN)
# -----------------------------------------------------------------------------
# Google STUN servers are used by default. For strict NAT/firewall traversal in
# production, configure a Coturn or Twilio/Xirsys TURN server below:
# TURN_URL=turn:turn.yourdomain.com:3478?transport=udp,turn:turn.yourdomain.com:3478?transport=tcp
# TURN_USERNAME=turn_user
# TURN_CREDENTIAL=turn_password
